#!/usr/bin/env bash
# Hook pre-commit : rappelle de mettre à jour la doc si du code important change.
#
# Activation (une fois, à la racine du repo) :
#     git config core.hooksPath .githooks
#
# Le hook AVERTIT par défaut (n'empêche pas le commit) — la GitHub Action, elle,
# est bloquante sur les PR. Pour rendre ce hook bloquant en local, retirer --warn.
# Contourner ponctuellement : git commit --no-verify

set -u

# Choix de l'interpréteur Python (venv local prioritaire si présent).
if [ -x "venv/Scripts/python.exe" ]; then
    PY="venv/Scripts/python.exe"          # Windows venv
elif [ -x "venv/bin/python" ]; then
    PY="venv/bin/python"                  # *nix venv
elif command -v python >/dev/null 2>&1; then
    PY="python"
elif command -v py >/dev/null 2>&1; then
    PY="py"
else
    echo "pre-commit: Python introuvable — vérification doc ignorée."
    exit 0
fi

"$PY" scripts/check_docs_sync.py --staged --warn
exit 0
